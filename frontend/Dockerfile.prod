# Production image: build the bundle, then serve it as static files.
#
# The dev Dockerfile ends with `npm run dev`, which starts the Vite dev server —
# it re-transforms source on every request, holds a file watcher, and ignores the
# build output entirely. That is ~173 MB resident. Nginx serving the same bundle
# is ~15 MB and materially faster to load.
#
# Note: Vite inlines VITE_* at BUILD time, so they are ARGs here, not runtime
# env. Left empty the app talks to its own origin, which is what we want behind
# Caddy or an ALB.
FROM node:20-alpine AS build
WORKDIR /repo

COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY shared ./shared
COPY frontend ./frontend

RUN npm install --workspaces --include-workspace-root=false

ARG VITE_API_BASE_URL=""
ARG VITE_WS_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_WS_URL=$VITE_WS_URL

RUN npm run build -w @manufacturing-agent/shared \
 && npm run build -w @manufacturing-agent/frontend

FROM nginx:1.27-alpine
COPY --from=build /repo/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 5173
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://localhost:5173/ >/dev/null || exit 1
