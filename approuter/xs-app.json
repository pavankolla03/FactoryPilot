{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "orchestrator",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/ws/(.*)$",
      "target": "/ws/$1",
      "destination": "orchestrator",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}
